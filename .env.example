# SIGNBRIDGE Environment Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Camera and Vision Settings
CAMERA_INDEX=0
RECOGNITION_FPS=15
CONFIDENCE_THRESHOLD=0.65
TEMPORAL_SMOOTHING_WINDOW=8
DEBOUNCE_FRAMES=10

# AI Models
ASL_MODEL_PATH=models/asl/asl_classifier.joblib
ISL_MODEL_PATH=models/isl/isl_classifier.joblib

# Ollama Local Service
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_SECONDS=10

# Text-to-Speech
TTS_RATE=160
TTS_VOLUME=1.0
